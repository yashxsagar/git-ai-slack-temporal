{
  "name": "temporal-vibe-automator-poc",
  "version": "1.0.0",
  "description": "Temporal POC for Vibe Automator - GitHub PR summarization with Slack notifications",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build.watch": "tsc --watch",
    "start:worker": "npm run build && node dist/worker/index.js",
    "start:webhook": "npm run build && node dist/webhook/server.js",
    "dev:worker": "ts-node src/worker/index.ts",
    "dev:webhook": "ts-node src/webhook/server.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "temporal",
    "workflow",
    "automation",
    "github",
    "slack",
    "openai"
  ],
  "author": "Vibe Automator Team",
  "license": "MIT",
  "dependencies": {
    "@temporalio/client": "^1.11.2",
    "@temporalio/worker": "^1.11.2",
    "@temporalio/workflow": "^1.11.2",
    "@temporalio/activity": "^1.11.2",
    "@temporalio/common": "^1.11.2",
    "@octokit/rest": "^20.0.2",
    "@slack/web-api": "^7.0.2",
    "openai": "^4.28.0",
    "express": "^4.18.2",
    "dotenv": "^16.4.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4",
    "nanoid": "^3.3.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.2.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
